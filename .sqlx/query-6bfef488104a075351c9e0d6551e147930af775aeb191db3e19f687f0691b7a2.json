  "query": "SELECT game_id, to_char(expires_at AT TIME ZONE 'UTC', 'YYYY-MM-DD\"T\"HH24:MI:SS.US\"Z\"') AS \"expires_at!\", (consumed_at IS NOT NULL) AS \"consumed!\"\n         FROM entry_tickets WHERE account_id = $1 ORDER BY COALESCE(issued_at, expires_at) DESC, expires_at DESC, game_id LIMIT 20",
