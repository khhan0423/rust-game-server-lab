  "query": "SELECT a.account_id, a.status AS \"status: AccountStatus\"\n         FROM accounts a JOIN account_identities i USING (account_id)\n         WHERE i.provider = $1 AND i.subject = $2 AND i.secret_hash = sha256($3)\n         FOR SHARE OF a, i",
